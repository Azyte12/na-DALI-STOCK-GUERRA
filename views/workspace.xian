<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#e6007e">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/workspace.css?v=database">
  <script src="/workspace.js?v=database" defer></script>
</head>
<body>
  <aside class="sidebar" id="sidebar">
    <a class="brand" href="#overview" aria-label="DALIStock home"><span class="brand-mark">DALI<span>EVERYDAY GROCERY</span></span><span class="brand-word">Stock<span>Inventory workspace</span></span></a>
    <div class="workspace-label">WORKSPACE</div>
    <nav aria-label="Main navigation" id="navigation"></nav>
    <div class="sidebar-bottom"><div class="help-card"><span class="help-icon">?</span><strong>A little help goes a long way.</strong><p>Your guide to keeping every shelf ready.</p><button class="text-button" id="guide">View quick guide <span>↗</span></button></div><div class="profile"><span class="avatar">AM</span><div><strong id="profile-name">Loading account…</strong><small id="profile-role"></small></div><form method="post" action="/logout"><input type="hidden" name="_csrf" id="logout-csrf"><button class="icon-button logout-button" aria-label="Sign out" title="Sign out">↪</button></form></div></div>
  </aside>
  <div class="app-shell">
    <header class="topbar"><div class="breadcrumb"><button id="menu-toggle" class="icon-button mobile-menu" aria-label="Toggle navigation">☰</button><span>Workspace</span><span class="slash">/</span><strong id="breadcrumb">Overview</strong></div><div class="topbar-right"><button class="text-button demo-label" id="refresh-data" title="Refresh saved inventory"><i></i> Refresh data ↻</button><span class="separator"></span><span class="date" id="today"></span><button class="icon-button" id="notifications" aria-label="View stock alerts"><svg viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg><i class="notification-dot"></i></button><span class="avatar small">AM</span></div></header>
    <main>
      <section class="page-heading"><div><div class="eyebrow">A CLEAR VIEW. A BETTER EVERYDAY.</div><h1 id="page-title">Your inventory, in focus<span>.</span></h1><p id="page-description">Keep your branches stocked and your operations moving.</p></div><div class="heading-actions"><label class="branch-picker"><svg viewBox="0 0 24 24"><path d="M3 10h18M4 10v11h16V10M3 10l2-7h14l2 7M9 21v-7h6v7"/></svg><select id="branch" aria-label="Filter by branch"><option value="all">All accessible branches</option></select></label><button class="button primary" id="new-request">＋ New request</button></div></section>
      <div id="content"></div>
      <footer class="page-footer"><span><b>DALIStock</b> · Every shelf. Every branch.</span><span>Shared inventory · MySQL database</span></footer>
    </main>
  </div>
  <dialog id="modal"><form id="modal-form"><div class="modal-heading"><div><div class="eyebrow">DALISTOCK WORKSPACE</div><h2 id="modal-title"></h2></div><button type="button" class="icon-button" id="close-modal" aria-label="Close dialog">✕</button></div><div id="modal-body"></div><div class="modal-actions"><button type="button" class="button" id="cancel-modal">Cancel</button><button type="submit" class="button primary" id="submit-modal">Save</button></div></form></dialog>
  <div id="toast" role="status" aria-live="polite"></div>
</body>
</html>
